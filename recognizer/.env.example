# Copy to .env (gitignored) and fill in.

# Firebase console > Project settings > Service accounts > Generate new private key.
# Save the file in this folder; it is a full-access password, never commit it.
SERVICE_ACCOUNT_KEY=serviceAccountKey.json
FIREBASE_PROJECT_ID=facelock-eldroid
# Firebase console > Storage: the bucket name at the top, without gs://
FIREBASE_STORAGE_BUCKET=facelock-eldroid.appspot.com

# Same value as SECRET_RECOGNIZE_KEY in the board's secrets.h.
DEVICE_KEY=change-me-to-a-long-random-string

# Optional
PORT=5000
# 0.363 is OpenCV's recommended cut-off; higher = stricter.
MATCH_THRESHOLD=0.363
ENROLL_SYNC_SECONDS=15
