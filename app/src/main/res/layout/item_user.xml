<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="@dimen/avatar_size"
                android:layout_height="@dimen/avatar_size"
                android:background="@drawable/bg_avatar">
                <TextView
                    android:id="@+id/tvInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_dark"
                    tools:text="SC" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_ms"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvName"
                    style="@style/T.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Sam Cortes" />

                <TextView
                    android:id="@+id/tvEmail"
                    style="@style/T.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="sam@example.com" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatus"
                style="@style/Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                tools:text="Active"
                tools:background="@drawable/pill_granted" />
        </LinearLayout>

        <View
            style="@style/Divider"
            android:layout_marginVertical="@dimen/space_ms" />

        <!-- Role · locker · face state, as compact metadata chips. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvRole"
                style="@style/Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_neutral"
                android:textColor="@color/text_secondary"
                tools:text="ADMIN" />

            <TextView
                android:id="@+id/tvLocker"
                style="@style/T.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                tools:text="Locker LKR-01" />

            <TextView
                android:id="@+id/tvFace"
                style="@style/T.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_sm"
                android:gravity="end"
                android:textStyle="bold"
                tools:text="Face enrolled" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_ms">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRole"
                style="@style/Btn.Small"
                android:layout_width="0dp"
                android:layout_weight="1"
                app:icon="@drawable/ic_shield"
                app:iconGravity="textStart"
                android:text="@string/action_role" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggle"
                style="@style/Btn.Small"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_sm"
                app:icon="@drawable/ic_ban"
                app:iconGravity="textStart"
                tools:text="Suspend" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Btn.Small.Danger"
                android:layout_width="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text=""
                android:contentDescription="@string/action_remove" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
