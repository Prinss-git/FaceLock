<?xml version="1.0" encoding="utf-8"?>
<!--
  Shown once, to the admin who approved a reset. The value is not stored
  anywhere, so this dialog is the only place it can be read: it is sized to be
  read aloud accurately and can be copied in one tap.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_lg"
    android:paddingTop="@dimen/space_sm"
    android:paddingBottom="@dimen/space_xs">

    <TextView
        android:id="@+id/tvFor"
        style="@style/T.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Temporary password for Sam Cortes." />

    <TextView
        android:id="@+id/tvPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_ms"
        android:background="@drawable/bg_sunken"
        android:fontFamily="monospace"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:padding="@dimen/space_md"
        android:textColor="@color/text_primary"
        android:textIsSelectable="true"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="K7m-4qP2xw9R" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCopy"
        style="@style/Btn.Outline"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="@dimen/space_ms"
        app:icon="@drawable/ic_check"
        app:iconGravity="textStart"
        android:text="@string/copy_password" />

    <TextView
        style="@style/T.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_ms"
        android:text="@string/temp_password_note" />
</LinearLayout>
