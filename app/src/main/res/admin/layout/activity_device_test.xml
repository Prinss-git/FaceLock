<?xml version="1.0" encoding="utf-8"?>
<!--
  Two-way link check between the phone and the ESP32 over the Realtime
  Database. The big numeral is whatever is live at test/data right now; the
  field below writes a new value back to the same key.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/device_test_title"
        app:navigationIcon="@drawable/ic_back"
        app:navigationContentDescription="@string/action_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin">

            <!-- ===================== Live value ===================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/transparent"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/T.Label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_on_dark_muted"
                            android:text="@string/device_test_path" />

                        <TextView
                            android:id="@+id/tvConnection"
                            style="@style/Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/pill_neutral"
                            android:textColor="@color/text_secondary"
                            tools:text="Connected" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:textSize="56sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.04"
                        android:textColor="@color/text_on_dark"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="42" />

                    <TextView
                        android:id="@+id/tvUpdated"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/text_on_dark_muted"
                        tools:text="Updated Today 1:45 PM" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== Write ===================== -->
            <TextView
                style="@style/T.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/device_test_write" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilValue"
                style="@style/Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/device_test_new_value">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberSigned"
                    android:imeOptions="actionDone"
                    android:maxLength="9"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWrite"
                style="@style/Btn.Primary"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_ms"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                android:text="@string/device_test_send" />

            <!-- Quick values, so the link can be proved without the keyboard. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnZero"
                    style="@style/Btn.Outline"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:text="@string/device_test_zero" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHundred"
                    style="@style/Btn.Outline"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="@string/device_test_hundred" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRandom"
                    style="@style/Btn.Outline"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="@string/device_test_random" />
            </LinearLayout>

            <!-- ===================== Warning ===================== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                app:cardBackgroundColor="@color/warning_wash"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/card_padding">

                    <ImageView
                        android:layout_width="@dimen/icon_size"
                        android:layout_height="@dimen/icon_size"
                        android:src="@drawable/ic_alert"
                        app:tint="@color/warning"
                        android:importantForAccessibility="no" />

                    <TextView
                        style="@style/T.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_ms"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:text="@string/device_test_overwrite_warning" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
