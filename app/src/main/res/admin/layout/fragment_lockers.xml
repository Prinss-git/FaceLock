<?xml version="1.0" encoding="utf-8"?>
<!-- Lockers tab: heading, search, then lockers grouped building → floor. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="bottom"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_xs">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/T.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="26sp"
                    android:text="@string/nav_lockers" />

                <TextView
                    android:id="@+id/tvHeadingSub"
                    style="@style/T.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="@string/heading_sub_admin" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuildings"
                style="@style/Btn.Small"
                android:layout_width="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/buildings"
                app:icon="@drawable/ic_location"
                app:iconGravity="textStart" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSearch"
            style="@style/Field.Search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_md"
            android:hint="@string/search_lockers_grouped"
            app:endIconMode="clear_text">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Status filter; counts follow the search. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/space_sm"
            android:clipToPadding="false"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/statusGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:chipSpacingHorizontal="@dimen/space_sm">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStatusAll"
                    style="@style/Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/status_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStatusFree"
                    style="@style/Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_free" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStatusOccupied"
                    style="@style/Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_occupied" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStatusOut"
                    style="@style/Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_out" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Count, then fold/unfold every building at once. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCount"
                style="@style/T.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="13 lockers" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExpandAll"
                style="@style/Btn.Text"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:minWidth="0dp"
                android:paddingHorizontal="@dimen/space_sm"
                android:text="@string/expand_all"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCollapseAll"
                style="@style/Btn.Text"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:minWidth="0dp"
                android:paddingHorizontal="@dimen/space_sm"
                android:text="@string/collapse_all"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/screen_margin"
                android:paddingBottom="@dimen/list_bottom_inset"
                android:scrollbars="none"
                tools:listitem="@layout/item_locker_row" />

            <include
                android:id="@+id/empty"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <include
                android:id="@+id/skeleton"
                layout="@layout/view_skeleton_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAdd"
        style="@style/Fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/screen_margin"
        android:text="@string/add_locker"
        app:icon="@drawable/ic_add" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
