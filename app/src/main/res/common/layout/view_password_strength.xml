<?xml version="1.0" encoding="utf-8"?>
<!--
  Strength bar + live requirement checklist. Included by every screen that sets
  a password, so the feedback is identical in all of them.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="@dimen/space_sm"
    android:background="@drawable/bg_sunken"
    android:padding="@dimen/space_ms">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/barStrength"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp"
            app:trackColor="@color/divider"
            app:indicatorColor="@color/text_tertiary" />

        <TextView
            android:id="@+id/tvStrengthLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_ms"
            android:minWidth="48dp"
            android:gravity="end"
            android:textSize="12sp"
            android:fontFamily="@font/barlow_semibold"
            android:textColor="@color/text_tertiary"
            tools:text="Strong" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRequirements"
        style="@style/T.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:textSize="12sp"
        android:lineSpacingExtra="4dp"
        tools:text="At least 8 characters" />
</LinearLayout>
