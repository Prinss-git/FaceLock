<?xml version="1.0" encoding="utf-8"?>
<!--
  Member shell: swappable content + bottom navigation. The three tabs live in
  ui/user/ as fragments.

  There is no app bar. Each tab carries its own heading in the content, and
  Sign out lives on the Profile tab - which left the bar with nothing in it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">


    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View style="@style/Divider" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/menu_member_bottom" />
</LinearLayout>
