<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_xl">

        <!-- ===================== Greeting ===================== -->
        <TextView
            android:id="@+id/tvGreeting"
            style="@style/T.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            tools:text="Good morning, Sam" />

        <TextView
            android:id="@+id/tvGreetingSub"
            style="@style/T.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            tools:text="Your locker is locked and ready." />

        <!-- ===================== Locker status ===================== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_card"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/T.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_on_dark_muted"
                        android:text="@string/label_your_locker" />

                    <TextView
                        android:id="@+id/tvLockerStatusPill"
                        style="@style/Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/pill_accent"
                        android:textColor="@color/accent_dark"
                        tools:text="Locked" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLockerId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textSize="38sp"
                    android:fontFamily="@font/barlow_semibold"
                    android:letterSpacing="-0.04"
                    android:textColor="@color/text_on_dark"
                    tools:text="LKR-01" />

                <TextView
                    android:id="@+id/tvLockerStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textSize="14sp"
                    android:textColor="@color/text_on_dark_muted"
                    tools:text="Assigned to you" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="@dimen/space_md"
                    android:background="@color/ink_600" />

                <LinearLayout
                    android:id="@+id/rowLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_location"
                        app:tint="@color/text_on_dark_muted"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/tvLockerLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:textSize="13sp"
                        android:textColor="@color/text_on_dark_muted"
                        tools:text="2nd floor, Main building" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowLastOpened"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_history"
                        app:tint="@color/text_on_dark_muted"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/tvLastOpened"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:textSize="13sp"
                        android:textColor="@color/text_on_dark_muted"
                        tools:text="Last opened Sep 8, 2026  2:14 PM" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================== Face enrollment ===================== -->
        <TextView
            style="@style/T.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/section_face_id" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:id="@+id/faceIconWrap"
                        android:layout_width="@dimen/icon_badge"
                        android:layout_height="@dimen/icon_badge"
                        android:background="@drawable/bg_icon_circle">
                        <ImageView
                            android:id="@+id/ivFace"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_face"
                            app:tint="@color/text_secondary"
                            android:importantForAccessibility="no" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/space_ms"
                        android:orientation="vertical">

                        <TextView
                            style="@style/T.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/face_template" />

                        <TextView
                            android:id="@+id/tvFaceSub"
                            style="@style/T.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            tools:text="Your face template is on file" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvFaceStatus"
                        style="@style/Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Enrolled"
                        tools:background="@drawable/pill_granted" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnroll"
                    style="@style/Btn.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="@dimen/space_ms"
                    app:icon="@drawable/ic_camera"
                    app:iconGravity="textStart"
                    tools:text="Enroll my face" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================== Recent activity ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_sm"
            android:gravity="center_vertical">

            <TextView
                style="@style/T.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/section_recent_access" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewAll"
                style="@style/Btn.Text"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="@dimen/space_sm"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/view_all" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRecent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerRecent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingVertical="@dimen/space_xs"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_log" />

                <TextView
                    android:id="@+id/tvNoHistory"
                    style="@style/T.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="@dimen/space_lg"
                    android:text="@string/empty_my_history_body"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/skeleton"
        layout="@layout/view_skeleton_locker"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
