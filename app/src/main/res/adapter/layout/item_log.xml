<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Result colour rail: readable before any text is. -->
        <View
            android:id="@+id/viewIndicator"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/granted" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="@dimen/space_ms">

            <FrameLayout
                android:id="@+id/iconWrap"
                android:layout_width="@dimen/icon_badge"
                android:layout_height="@dimen/icon_badge"
                android:background="@drawable/pill_granted">
                <ImageView
                    android:id="@+id/ivResult"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_ms"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUser"
                    style="@style/T.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Sam Cortes" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp">

                    <TextView
                        android:id="@+id/tvLocker"
                        style="@style/T.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Locker LKR-01" />

                    <TextView
                        android:id="@+id/tvConfidence"
                        style="@style/T.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:textColor="@color/accent_dark"
                        android:visibility="gone"
                        tools:text="Match 97%"
                        tools:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTime"
                    style="@style/T.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textSize="11sp"
                    tools:text="Sep 8, 2026  2:14 PM" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvResult"
                style="@style/Pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                tools:text="Granted"
                tools:background="@drawable/pill_granted" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
