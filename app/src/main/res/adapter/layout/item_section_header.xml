<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsible section header (a day in Logs/History/Trail, a role in Users). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_xs"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_target"
    android:paddingHorizontal="@dimen/space_xs">

    <TextView
        android:id="@+id/tvTitle"
        style="@style/T.Subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="Today" />

    <TextView
        android:id="@+id/tvCount"
        style="@style/T.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        tools:text="12" />

    <ImageView
        android:id="@+id/ivChevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/space_sm"
        android:src="@drawable/ic_chevron"
        android:importantForAccessibility="no"
        app:tint="@color/text_tertiary" />
</LinearLayout>
