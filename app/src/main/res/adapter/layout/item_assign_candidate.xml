<?xml version="1.0" encoding="utf-8"?>
<!-- One member in the "Assign locker" picker: avatar, name over email, and a
     tag when they are the current holder or already hold another locker. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/touch_target"
    android:baselineAligned="false"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/space_lg"
    android:paddingVertical="10dp">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_avatar">
        <TextView
            android:id="@+id/tvInitials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="13sp"
            android:fontFamily="@font/barlow_semibold"
            android:textColor="@color/accent_dark"
            tools:text="JD" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/space_ms"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            style="@style/T.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Juan Dela Cruz" />

        <TextView
            android:id="@+id/tvEmail"
            style="@style/T.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:ellipsize="middle"
            tools:text="juan.cruz@students.uc.edu.ph" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTag"
        style="@style/Pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_sm"
        android:visibility="gone"
        tools:visibility="visible"
        tools:background="@drawable/pill_warning"
        tools:text="Has L-001" />
</LinearLayout>
