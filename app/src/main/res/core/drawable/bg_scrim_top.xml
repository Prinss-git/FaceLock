<?xml version="1.0" encoding="utf-8"?>
<!--
  The toolbar sits transparent over the camera preview, so its white title and
  close icon vanish whenever the camera is pointed at something bright. This
  gradient keeps them readable without boxing the toolbar in.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:startColor="#B3060B12"
        android:centerColor="#59060B12"
        android:endColor="#00060B12"
        android:angle="270" />
</shape>
