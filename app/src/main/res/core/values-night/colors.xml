<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark palette. Same token names as values/colors.xml.

  Two deliberate inversions:
  · the ink ramp gets *lighter* as it goes up, because in dark mode those
    tokens act as elevated surfaces rather than as a dark header on white;
  · accent_dark and the semantic colours are lightened, since they are read
    as text on a dark ground where the light-mode versions fail contrast.
-->
