<?xml version="1.0" encoding="utf-8"?>
<!--
  Night only needs to fix what the colour tokens cannot express: the system
  bars. Everything else themes itself through values-night/colors.xml.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.FaceLock" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ink_800</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/accent_wash</item>
        <item name="colorOnPrimaryContainer">@color/accent_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/ink_950</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_sunken</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/denied</item>
        <item name="colorOnError">@color/ink_950</item>
        <item name="android:colorBackground">@color/background</item>

        <item name="android:statusBarColor">@color/ink_950</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <!-- The only real difference: dark nav bar wants light buttons. -->
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <item name="materialCardViewStyle">@style/Card</item>
        <item name="materialAlertDialogTheme">@style/AlertDialog</item>
        <item name="android:textColorHighlight">@color/accent_soft</item>
        <item name="android:fontFamily">@font/barlow</item>
        <item name="fontFamily">@font/barlow</item>
    </style>

    <!-- In dark mode a bright teal button reads better than the near-black
         primary, which would disappear into the page. -->
    <style name="Btn.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/field_radius</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/barlow_medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/ink_950</item>
        <item name="iconTint">@color/ink_950</item>
        <item name="rippleColor">@color/ink_700</item>
    </style>

    <style name="Fab" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/ink_950</item>
        <item name="iconTint">@color/ink_950</item>
        <item name="elevation">3dp</item>
    </style>
</resources>
