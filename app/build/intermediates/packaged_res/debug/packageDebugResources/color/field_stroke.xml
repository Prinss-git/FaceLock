<?xml version="1.0" encoding="utf-8"?>
<!--
  Text field outline. Order matters: error and focused must come before the
  catch-all, and the disabled state before enabled.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/divider" android:state_enabled="false" />
    <item android:color="@color/accent" android:state_focused="true" />
    <item android:color="@color/outline" android:state_hovered="true" />
    <item android:color="@color/outline" />
</selector>
