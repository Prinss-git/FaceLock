rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Staff powers end the moment an account is suspended, not at its next
    // sign-in: the app signs them out, and these rules refuse them meanwhile.
    function isAdmin() {
      return signedIn() && myProfile().role == 'ADMIN' && myProfile().active == true;
    }

    function isSecurity() {
      return signedIn() && myProfile().role == 'SECURITY' && myProfile().active == true;
    }


    // ---------- users ----------
    match /users/{uid} {
      // A user reads only their own profile; staff read everyone.
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || isSecurity());

      // Self-registration is allowed, but never with an elevated role.
      // Admins provision accounts of any role for other people.
      allow create: if isAdmin()
                    || (signedIn()
                        && request.auth.uid == uid
                        && request.resource.data.role == 'USER'
                        && request.resource.data.active == true);

      // Users may only flip their own faceEnrolled flag; admins may edit anything.
      allow update: if isAdmin()
                    || (signedIn() && request.auth.uid == uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(['faceEnrolled', 'fcmToken']));

      allow delete: if isAdmin();
    }

    // ---------- lockers ----------
    match /lockers/{lockerId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      // Only admins reassign or remotely unlock.
      allow update: if isAdmin();
    }

    // ---------- buildings ----------
    match /buildings/{code} {
      // Everyone signed in sees the grouping; only admins change it.
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- admin activity trail ----------
    match /admin_actions/{actionId} {
      // Append-only: an admin may add an entry in their own name, and nobody
      // may edit or erase one afterwards.
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- access logs ----------
    match /access_logs/{logId} {
      // Users see their own history; admins and security see everything.
      allow read: if isAdmin() || isSecurity()
                  || (signedIn() && resource.data.uid == request.auth.uid);

      // Logs are written server-side only (Cloud Function with admin SDK),
      // so no client may create, edit, or erase the audit trail.
      allow write: if false;
    }
  }
}
