rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Staff powers end the moment an account is suspended, not at its next
    // sign-in: the app signs them out, and these rules refuse them meanwhile.
    function isAdmin() {
      return signedIn() && hasProfile() && myProfile().role == 'ADMIN' && myProfile().active == true;
    }

    function isSecurity() {
      return signedIn() && hasProfile() && myProfile().role == 'SECURITY' && myProfile().active == true;
    }

    // A locker board signs in with its own account, linked to exactly one
    // locker by devices/{uid}. Device accounts have no users/ profile.
    function isDeviceFor(lockerId) {
      return signedIn()
          && exists(/databases/$(database)/documents/devices/$(request.auth.uid))
          && get(/databases/$(database)/documents/devices/$(request.auth.uid)).data.lockerId == lockerId;
    }


    // ---------- users ----------
    match /users/{uid} {
      // A user reads only their own profile; staff read everyone.
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || isSecurity());

      // Self-registration is allowed, but never with an elevated role.
      // Admins provision accounts of any role for other people.
      allow create: if isAdmin()
                    || (signedIn()
                        && request.auth.uid == uid
                        && request.resource.data.role == 'USER'
                        && request.resource.data.active == true);

      // Users may only flip their own faceEnrolled flag; admins may edit anything.
      allow update: if isAdmin()
                    || (signedIn() && request.auth.uid == uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(['faceEnrolled', 'fcmToken']));

      allow delete: if isAdmin();
    }

    // ---------- lockers ----------
    match /lockers/{lockerId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      // Only admins reassign or request a remote unlock. The locker's own
      // board may heartbeat, stamp an opening, and clear (never set) the
      // unlock flag.
      allow update: if isAdmin()
                    || (isDeviceFor(lockerId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['unlockRequested', 'lastOpenedAt', 'lastSeenAt'])
                        && (!request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['unlockRequested'])
                            || request.resource.data.unlockRequested == false));
    }

    // ---------- devices ----------
    match /devices/{uid} {
      // Created in the Firebase console; no client writes them.
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    // ---------- buildings ----------
    match /buildings/{code} {
      // Everyone signed in sees the grouping; only admins change it.
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- admin activity trail ----------
    match /admin_actions/{actionId} {
      // Append-only: an admin may add an entry in their own name, and nobody
      // may edit or erase one afterwards.
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- access logs ----------
    match /access_logs/{logId} {
      // Users see their own history; admins and security see everything.
      allow read: if isAdmin() || isSecurity()
                  || (signedIn() && resource.data.uid == request.auth.uid);

      // On the Spark plan the locker's board writes its own attempts. Only
      // for its own locker, with a fixed shape, and never edited or erased.
      allow create: if isDeviceFor(request.resource.data.lockerId)
                    && request.resource.data.keys().hasOnly(
                         ['lockerId', 'uid', 'userName', 'result', 'confidence', 'timestamp'])
                    && request.resource.data.result in ['GRANTED', 'DENIED']
                    && request.resource.data.timestamp is number;
      allow update, delete: if false;
    }
  }
}
